# ============================================================
# Lumina · 环境变量模板
# 复制为 .env 后填写；.env 已被 .gitignore 排除，永不提交。
# ============================================================

# ---------- 应用 ----------
APP_ENV=development          # development | staging | production
APP_NAME=lumina
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=console            # console | json
TZ=Asia/Shanghai

# ---------- 数据库 ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=lumina
POSTGRES_USER=lumina
POSTGRES_PASSWORD=change-me-in-env
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
# 同步 DSN（psycopg），由上面的变量拼装
DATABASE_URL=postgresql+psycopg://lumina:change-me-in-env@postgres:5432/lumina

# ---------- 向量库（pgvector，与主库同实例） ----------
PGVECTOR_TABLE=kb_chunks
PGVECTOR_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ---------- Redis ----------
# 开发环境可无密码；生产环境必须设置 REDIS_PASSWORD，并同步到 REDIS_URL：
#   REDIS_URL=redis://:your-password@redis:6379/0
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_CACHE_TTL=300
REDIS_SESSION_TTL=86400

# ---------- 对象存储（可选，本地用 MinIO） ----------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lumina
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---------- 检索 ----------
# BM25 引擎：elasticsearch | quickwit | none（none 时降级为纯向量）
SEARCH_BACKEND=elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=lumina-kb
QUICKWIT_URL=http://quickwit:6333
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=5
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=40

# ---------- 模型网关 ----------
# 主模型（云端，OpenAI 兼容协议）
LLM_PROVIDER=openai
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# 备用模型（故障降级链，按顺序 fallback）
LLM_FALLBACK_MODELS=qwen-turbo,deepseek-chat

# 思考型模型（用于认知重构等需要推理的任务）
LLM_REASONING_MODEL=qwen-max
LLM_REASONING_TEMPERATURE=0.3

# 本地自部署模型（vLLM / Ollama / SGLang）
LLM_LOCAL_ENABLED=true
LLM_LOCAL_BASE_URL=http://vllm:8000/v1
LLM_LOCAL_API_KEY=EMPTY
LLM_LOCAL_MODEL=lumina-intent-lora

# ---------- ModelScope（魔搭社区）----------
# Token 获取：https://modelscope.cn 右上角头像 → 访问令牌 → 新建令牌
# 用途：拉取基座模型、推送微调产物、vLLM 直接从魔搭加载权重
MODELSCOPE_TOKEN=
MODELSCOPE_ENDPOINT=https://www.modelscope.cn/api/v1
MODELSCOPE_CACHE_DIR=~/.cache/modelscope
# 微调产物仓库 ID（形如 your-org/lumina-intent-lora）
MODELSCOPE_REPO_ID=
# 本地推理模型来源：modelscope | local | huggingface
LOCAL_MODEL_SOURCE=modelscope
LOCAL_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# 嵌入模型
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=http://embedding:8000/v1
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---------- 安全 ----------
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:10086
RATE_LIMIT_PER_MIN=60
# 心理健康场景：开启后触发危机词检测，走人工/急救引导流程
SAFETY_CRISIS_DETECTION=true
SAFETY_CRISIS_KEYWORDS=自杀,自残,轻生,不想活,结束生命,伤害自己

# ---------- 微信小程序 ----------
WECHAT_APPID=wx0000000000000000
WECHAT_SECRET=replace-me
WECHAT_PAY_MOCK=true

# ---------- 观测 ----------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
SENTRY_DSN=
PROMETHEUS_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- 评测 ----------
EVAL_DATASET_DIR=packages/datasets/golden
EVAL_BATCH_SIZE=20
EVAL_CONCURRENCY=4
EVAL_FAIL_THRESHOLD=0.15
